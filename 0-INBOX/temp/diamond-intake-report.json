  "unmapped_rows": [
   {
    "row": 216,
    "text": "न रूपशब्दगन्धरसस्पर्शधर्मप्रतिष्ठितेन दानं दातव्यम्॥",
    "kept_in_block": "215"
   },
   {
    "row": 311,
    "text": "भगवानाह-तत्किं मन्यसे सुभूते यावन्त्यो गङ्गायां महानद्यां वालुकाः, अपि नु ता वालुकास्तथागतेन भाषिताः ? सुभूतिराह-एवमेतद्भगवन्, एवमेतत् सुगत। भाषितास्तथागतेन वालुकाः। ",
    "kept_in_block": "309"
   },
   {
    "row": 376,
    "text": "यथाहं भगवतो भाषितस्यार्थमाजानामि, ",
    "kept_in_block": "373"
   },
   {
    "row": 379,
    "text": "एवमेतद्यथा वदसि। ",
    "kept_in_block": "375"
   },
   {
    "row": 420,
    "text": "न सम्यग्वदमानो वदेत्। ",
    "kept_in_block": "415"
   },
   {
    "row": 431,
    "text": "तथा प्रकाशयेत्, तेनोच्यते संप्रकाशयेदिति॥",
    "kept_in_block": "425"
   }
  ],
