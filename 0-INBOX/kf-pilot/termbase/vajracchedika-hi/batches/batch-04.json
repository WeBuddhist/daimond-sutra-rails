  "examples": [
   {
    "id": "4-8",
    "bo": "དེ་བཞིན་དུ་སྒྲ་དང༌། དྲི་དང་། རོ་དང༌། རེག་བྱ་དང༌། ཆོས་ལ་ཡང་མི་གནས་པར་སྦྱིན་པ་སྦྱིན་པར་བྱའོ། །",
    "gemini_zero_shot": "उसी प्रकार शब्द, गन्ध, रस, स्पर्श और धर्म में भी प्रतिष्ठित हुए बिना दान देना चाहिए।"
   },
   {
    "id": "6-21",
    "bo": "རབ་འབྱོར་བྱང་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་དེ་དག་ཀྱང་ཆོས་སུ་འདུ་ཤེས་པ་དང༌། ཆོས་མེད་པར་ཡང་འདུ་ཤེས་མི་འཇུག་སྟེ།",
    "gemini_zero_shot": "हे सुभूति, उन बोधिसत्त्व महासत्त्वों में धर्म-संज्ञा और अधर्म-संज्ञा भी प्रवृत्त नहीं होती है;"
   },
   {
    "id": "6-28",
    "bo": "དེ་བས་ན་དེ་ལས་དགོངས་ཏེ་དེ་བཞིན་གཤེགས་པས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་གཟིངས་ལྟ་བུར་ཤེས་པ་རྣམས་ཀྱིས་ཆོས་རྣམས་ཀྱང་སྤང་བར་བྱ་ན། ཆོས་མ་ཡིན་པ་རྣམས་ལྟ་ཅི་སྨོས། ཞེས་གསུངས་སོ། །",
    "gemini_zero_shot": "इसीलिए, इसी अभिप्राय से तथागत ने यह कहा है: इस धर्म-पर्याय को बेड़े के समान जानने वालों को धर्मों को भी त्याग देना चाहिए, फिर अधर्मों का तो कहना ही क्या!"
   }
  ]
 },
