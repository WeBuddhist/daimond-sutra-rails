  "tibetan": "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ། རབ་འབྱོར་འདི་ཇི་སྙམ་དུ་སེམས།",
  "sanskrit": "भगवानाह- तकिं मन्यसे सुभूते",
  "commentaries": {
   "bo-chone-drakpa-shedrub": [
    {
     "id": "2-47",
     "text": "དེས་ན་བདེན་འཛིན་གྱི་ ཞེན་ཡུལ་སུན་འབྱིན་མྱོང་མ་མྱོང་ནི་བདེན་མེད་རྟོགས་མྱོང་མ་མྱོང་བའི་སྒོ་ནས་འཇོག་སྟེ། ཇི་སྲིད་གཞི་གང་ལ་བདེན་པར་གྲུབ་བམ་མ་གྲུབ་སྙམ་དུ་དཔྱོད་པ་ཞུགས་པ་ན་བདེན་ཞེན་ལས་འདའ་མི་ནུས་པའི་བར་དེ་སྲིད་དུ་བདེན་འཛིན་གྱི་ཞེན་ཡུལ་ སུན་འབྱིན་མི་ནུས་པས་བདེན་འཛིན་གྱིས་བཅིངས་པར་འཇོག་གོ །དེ་བཞིན་དུ་ལན་ཅིག་ཕྱིར་འོང་བ་དང་ཕྱིར་མི་འོང་བ་དང་དགྲ་བཅོམ་པ་གསུམ་ལ་སྦྱར་ནས་གསུངས་པ་ལྟར་ཏེ་དོན་ནི་སྔར་ལྟར་རོ། །རྒྱུན་ཞུགས་སོགས་བཞི་ལ་ཞུགས་པ་དང་ འབྲས་གནས་ཟུང་རེ་ཡོད་པས་སོ་སོར་ཕྱེ་ན་གང་ཟག་ཡ་བརྒྱད་དང༌། ཟུང་རེ་བསྡོམས་ན་སྐྱེས་བུ་ཟུང་བཞིར་འགྱུར་རོ། །འདིའི་བཞི་ལ་བཤད་པ་མང་དུ་ཡོད་ཀྱང་མཚོན་ཙམ་ནི་རྒྱུན་ཞུགས་དགེ་སྦྱོང་ཚུལ་གྱི་འབྲས་བུ་འགོག་བདེན་ནི་ མཐོང་སྤངས་ཀུན་སྦྱོར་གསུམ་སྤངས་པའི་སྒོ་ནས་བཞག་པས། དེ་ལྟ་བུའི་འབྲས་བུ་དེ་ཐོབ་ནས་དེ་ལ་གནས་པ་ལ་ནི་རྒྱུན་ཞུགས་འབྲས་གནས་དང༌། དེ་ཐོབ་ཕྱིར་དུ་འབད་ཅིང་ཞུགས་པ་ལ་དེའི་ཞུགས་པ་ཞེས་བྱ་ཞིང༌། ཀུན་སྦྱོར་གསུམ་ནི། འཇིག་ལྟ་དང་ཚུལ་ཞུགས་མཆོག་འཛིན་དང་ཐེ་ཚོམ་ཉོན་མོངས་ཅན་ནོ། །འཇིག་ལྟ་ལ་ལྷན་སྐྱེས་ཡོད་ཀྱང་འདིར་ཀུན་བཏགས་སོ། །ཕྱིར་འོང་གི་འབྲས་བུ་ནི་འདོད་ཉོན་དྲུག་པ་སྤངས་པའི་ཆ་ནས་འཇོག་ཅིང༌། དེ་ལ་གནས་པ་ནི་དེའི་ འབྲས་གནས་དང༌། དེ་ཐོབ་ཕྱིར་དུ་བརྩོན་པས་འཇུག་པ་ནི་དེའི་ཞུགས་པའོ། ། ཕྱི་མི་འོང་གི་འབྲས་བུ་ནི་འདོད་ཉོན་དགུ་པ་སྤངས་པའི་ཆ་ནས་འཇོག་ཅིང༌། དེ་ལ་གནས་པ་དང་དེའི་ཆེད་དུ་ཞུགས་པ་ནི་འབྲས་གནས་དང་ཞུགས་པའོ། །དགྲ་བཅོམ་པའི་འབྲས་བུ་ནི་སྲིད་རྩེའི་ཉོན་མོངས་དགུ་པ་སྤངས་པའི་ཆ་ནས་འཇོག་ཅིང༌། འབྲས་བུ་དེ་ལ་གནས་པ་དང་དེ་ཐོབ་ཕྱིར་ཞུགས་པ་ནི་དགྲ་བཅོམ་འབྲས་གནས་དང་ཞུགས་པ་སྟེ་ཞིབ་ན་མང་དུ་བཤད་དགོས་པར་སྣང་ངོ༌། །ལན་ཅིག་ཕྱིར་འོང་བའི་དོན་ནི་འདོད་ཁམས་སུ་ད་དུང་སྐྱེ་བ་ལན་གཅིག་ལེན་དགོས་པ་དང༌། ཕྱིར་མི་འོང་བ་ནི་དེ་ལེན་མི་དགོས་པའོ། །གཞན་ཡང་ཕྱ …"
