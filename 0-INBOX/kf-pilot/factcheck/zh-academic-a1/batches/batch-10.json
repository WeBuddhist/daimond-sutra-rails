  "tibetan": "དེ་ཅིའི་ཕྱིར་ཞེ་ན། རབ་འབྱོར་དམན་པ་ལ་མོས་པ་རྣམས་ཀྱིས་ཆོས་ཀྱི་རྣམ་གྲངས་འདི་མཉན་པར་མི་ནུས་ཏེ།",
  "sanskrit": "तत्कस्य हेतोः ? न हि शक्यं सुभूते अयं धर्मपर्यायो हीनाधिमुक्तिकैः सत्त्वैः श्रोतुम्,",
  "commentaries": {
   "bo-chone-drakpa-shedrub": [
    {
     "id": "2-95",
     "text": "རྒྱུ་མཚན་ནི། ཆོས་དམན་པ་ལ་མོས་པ་རྣམས་ཀྱིས་ནི་ཆོས་ཀྱི་རྣམ་གྲངས་ཟབ་མོ་འདི་ལ་ཐོས་བསམ་བསྒོམས་པའི་ཚུལ་གྱིས་མཉན་པར་བྱར་མི་ནུས་ཏེ། གང་ཟག་གི་བདག་ཏུ་ལྟ་བ་དང་སེམས་ཅན་དང་སྲོག་དང་གང་ཟག་ཏུ་བདེན་ཞེན་གྱིས་ལྟ་ཞིང༌། འདོད་པའི་གང་ཟག་ཕྱི་རོལ་པ་ལྟ་བུ་རྣམས་ཀྱིས་གཞུང་འདིའི་ཚིག་དོན་མཉན་པ་དང་བླང་བ་སོགས་བྱེད་མི་ནུས་ཏེ། དེ་བྱེད་པའི་གནས་སམ་གོ་སྐབས་མེད་པའི་ཕྱིར་ཏེ། དེ་ལྟ་བུའི་སེམས་ཅན་རྣམས་ཀྱིས་བདག་མེད་པའི་དོན་མི་འདོད་པའི་ཕྱིར་རོ། །"
    }
