  "tibetan": "རབ་འབྱོར་གྱིས་གསོལ་པ། བཅོམ་ལྡན་འདས་མང་ལགས་སོ། །",
  "sanskrit": "सुभूतिराह-बहु भगवन्,",
  "commentaries": {
   "bo-chone-drakpa-shedrub": [
    {
     "id": "2-39",
     "text": "ཞེས་འབྱུང་བ་ལྟར། སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདི་གསེར་དང་དངུལ་དང་ཤེལ་དང་བཻ་ཌཱུརྱ་དང་རྡོའི་སྙིང་པོ་དང་སྤུག་དང་མུ་ཏིག་དམར་པོ་སྟེ་རིན་པོ་ཆེ་སྣ་བདུན་གྱིས་གང་བར་བྱས་ཏེ། གཞན་ལ་ སྦྱིན་པ་བྱིན་ན་བསོད་ནམས་ཀྱི་ཕུང་པོ་མང་དུ་བསྐྱེད་དམ་དྲིས་པས། ལན་དུ་རབ་འབྱོར་གྱིས་བསོད་ནམས་ཀྱི་ཕུང་པོ་མང་བར་ཞུས་ཤིང་བསོད་ནམས་ཀྱི་ཕུང་པོ་དེ་ཡང་རྨི་ལམ་དང་སྒྱུ་མ་ལྟ་བུར་ཐ་སྙད་ཙམ་དུ་ཡོད་པར་འཇོག་ལགས་ཀྱི། བསོད་ནམས་ཀྱི་ ཕུང་པོ་དེ་ཉིད་དོན་དམ་པར་ཕུང་པོར་གྲུབ་པ་མ་མཆིས་ཤིང༌། ཐ་སྙད་དུ་དེ་བཞིན་གཤེགས་པས་དེ་ལ་བསོད་ནམས་ཀྱི་ཕུང་པོ། བསོད་ནམས་ཀྱི་ཕུང་པོ་ཞེས་ཐ་སྙད་མཛད་ཅིང་གསུངས་སོ་ཞེས་གསོལ། འདིས་ནི་ལས་དཀར་ནག་སྔར་བྱས་པ་དང་ཕྱིས་བྱེད་པར་འགྱུར་བའི་འདས་པ་འགགས་ཤིང་མ་འོངས་པ་ད་ལྟ་མ་བྱུང་བས་མེད་ཀྱང༌། སྤྱིར་ཡོད་པར་འདོད་དགོས་ཤིང་དེ་ཉིད་བྱེད་པ་པོའི་སེམས་རྒྱུད་དང་འབྲེལ་བ་ལས་འབྲས་བུ་འབྱུང་བར་འདོད་དགོས་ཚུལ་ལ་སོགས་ བསྟན་ཏེ་ཅུང་དཀའ་བའི་གནས་ཡིན་ནོ། །ཚིགས་སུ་བཅད་པ་ཞེས་འབྱུང་བ་ནི་འདི་བོད་སྐད་དུ་ཚིགས་བཅད་མ་ཡིན་ཀྱང་ལེགས་སྦྱར་གྱི་སྐད་ལ་ཚིགས་བཅད་དུ་བསྒྲིགས་རྒྱུ་ཡོད་པ་ལ་དགོངས་པའོ། །བཟུང་བ་ནི་ཚིག་བློ་ལ་བཟུང་བ་དང༌། གླེགས་ བམ་ལག་ཏུ་ཡོད་པ་ལའང་བྱར་རུང་ཞིང་ཁ་ཏོན་བྱེད་པ་དང༌། ཡང་དག་པར་འཆད་པ་ནི་ཚིག་བརྗོད་ཅིང་ལེགས་པར་འཆད་པ་དང༌། སྟོན་པ་ནི་དོན་ལེགས་པར་སྟོན་པ་ལ་བཤད་ཅིང་དེ་ནི་གཙོ་ཆེ་བའི་དབང་དུ་མཛད་པའོ། ། དེ་ལྟར་བཟུང་བ་སོགས་ བྱས་ན་དེ་ལས་བསོད་ནམས་ཀྱི་ཕུང་པོ་ཆེས་གྲངས་མེད་ཅིང་དཔག་ཏུ་མེད་པ་ཞིག་བསྐྱེད་དོ། །"
    }
   ],
   "bo-kamalasila-tika": [
    {
     "id": "3-74",
     "text": "དེ་སྟོང་ལ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་སོ། །གཞི་དེ་ལས་ཞེས་བྱ་བ་ནི་རིན་པོ་ཆེ་སྦྱིན་པའི་གཞི་དེ་ལས་བསོད་ནམས་འདི་འབྱུང་བ་སྟེ། དེའི་རྒྱུ་ལས་བྱུང་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ། །བསོད་ནམས་ནི་སེམས་པ་དགེ་བ་ཐམས་ཅད་དང་། དེས་བསྐྱེད་པའི་བག་ཆགས་ཏེ། དེའི་ཕུང་པོ་ནི་ཚོགས་སོ། །འབྲས་བུ་མང་བའི་ཕྱིར་དེ་ཡང་མང་ངོ་། །མང་དུ་ཞེས་བྱ་བ་ནི་བྱེ་བྲག་གོ། །མང་ཞེས་ལན་གཉིས་བརྗོད་པས་ནི་རབ་ཏུ་མང་པོ་ཞེས་བསྙད་པའོ། །"
